# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Supabase (backend: Auth, Postgres, Row Level Security) ---
# Find all three in your Supabase project: Settings -> API.

# Client-safe (embedded in the browser bundle) - RLS is the real access
# control here, same trust model Firebase's public client config already had.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Server-only - used by api/_lib/supabaseAdmin.ts, which backs the Copilot
# chat and user-invite server functions (api/copilot-chat.ts,
# api/users-invite.ts, and the equivalent routes mounted in server.ts).
# Bypasses Row Level Security entirely - never expose this to the client,
# set it locally in .env and in Vercel's project environment variables only.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

NODE_ENV="development"

# Email (Resend) - the one live email mechanism (src/lib/emailService.ts),
# used server-side for invite + shift-summary emails. Without this set,
# emails are logged to the console instead of sent - safe default, not an error.
RESEND_API_KEY=""
EMAIL_FROM="hliastsironis@gmail.com"
