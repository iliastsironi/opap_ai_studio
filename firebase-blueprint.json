{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Represents a business organization or franchise operator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "legal_name": { "type": "string", "maxLength": 200 },
        "trade_name": { "type": "string", "maxLength": 200 },
        "vat_number": { "type": "string", "maxLength": 50 },
        "tax_office": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "timezone": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "legal_name", "trade_name", "vat_number", "timezone", "currency"]
    },
    "Store": {
      "title": "Store",
      "description": "Represents a store location (e.g., OPAP Agency, PLAY Store).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organization_id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "store_type": { "type": "string" },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "operating_hours": { "type": "string", "maxLength": 100 },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "organization_id", "code", "name", "store_type", "is_active"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user account in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 150 },
        "first_name": { "type": "string", "maxLength": 100 },
        "last_name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "employee_code": { "type": "string", "maxLength": 50 },
        "status": { "type": "string" },
        "last_login_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "email", "first_name", "last_name", "status"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Represents a shift record with financial figures and balance totals.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organization_id": { "type": "string" },
        "store_id": { "type": "string" },
        "store_name": { "type": "string", "maxLength": 100 },
        "register_id": { "type": "string", "maxLength": 50 },
        "shift_type": { "type": "string" },
        "status": { "type": "string" },
        "opened_by_user_id": { "type": "string" },
        "opened_by_user_name": { "type": "string", "maxLength": 100 },
        "opened_at": { "type": "string" },
        "closed_by_user_id": { "type": "string" },
        "closed_by_user_name": { "type": "string", "maxLength": 100 },
        "closed_at": { "type": "string" },
        "opening_cash": { "type": "number" },
        "opap_gross_sales": { "type": "number" },
        "opap_payouts": { "type": "number" },
        "opap_net_sales": { "type": "number" },
        "vlts_cash_in": { "type": "number" },
        "vlts_cash_out": { "type": "number" },
        "vlts_net": { "type": "number" },
        "scratch_lotto_sales": { "type": "number" },
        "fnb_sales": { "type": "number" },
        "fnb_cash": { "type": "number" },
        "fnb_card": { "type": "number" },
        "card_payments": { "type": "number" },
        "expenses_paid_cash": { "type": "number" },
        "customer_credit_granted": { "type": "number" },
        "customer_credit_collected": { "type": "number" },
        "bank_deposits": { "type": "number" },
        "counted_cash": { "type": "number" },
        "expected_cash": { "type": "number" },
        "discrepancy": { "type": "number" },
        "discrepancy_percentage": { "type": "number" },
        "discrepancy_threshold": { "type": "number" },
        "is_unbalanced": { "type": "boolean" },
        "employee_notes": { "type": "string", "maxLength": 1000 },
        "manager_notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "organization_id", "store_id", "register_id", "shift_type", "status", "opened_by_user_id"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System operational audit trace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organization_id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_email": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 100 },
        "entity_type": { "type": "string", "maxLength": 100 },
        "entity_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "action", "entity_type", "created_at"]
    },
    "MailTrigger": {
      "title": "MailTrigger",
      "description": "Firebase Trigger Email Extension documents",
      "type": "object",
      "properties": {
        "to": { "type": "array", "items": { "type": "string" } },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "html": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        "created_at": { "type": "string" }
      },
      "required": ["to", "message"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization documents"
    },
    "/organizations/{orgId}/stores/{storeId}": {
      "schema": "Store",
      "description": "Stores under organization"
    },
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Top-level stores"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Historical and active shift records"
    },
    "/expenses/{expenseId}": {
      "schema": "Shift",
      "description": "Expense records"
    },
    "/incidents/{incidentId}": {
      "schema": "Shift",
      "description": "Incident logs"
    },
    "/fnb_sales/{fnbId}": {
      "schema": "Shift",
      "description": "FnB sales logs"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit logging"
    },
    "/mail/{mailId}": {
      "schema": "MailTrigger",
      "description": "Trigger Email extension documents"
    }
  }
}
